# AIStudio2API 在 mini 上的配置（复制到 agent-tools/aistudio2api/.env）。
# PROXY_API_KEY 不写在这里：run-macos.sh 从 secrets/aistudio2api-token 读出来用环境变量传（环境变量优先于 .env）。
AISTUDIO_AUTH_STATES=auth
# 只听本机；对外只经 Funnel 网关的 /aistudio/v1/*（scripts/home-assistant-proxy.mjs）
LISTEN_ADDR=127.0.0.1:2048
PREVIEW_LISTEN_ADDR=127.0.0.1:2050
AUTO_START=true
HIDE_DOCK_ICON=true
# 不落请求正文：聊天内容只在 mini 和 Google 之间走，不写日志
REQUEST_BODY_LOG=false
LOG_FILE=true
LOG_MAX_TOTAL_MB=100
ADMIN_AUTH_ENABLED=false
UPSTREAM_CHANNELS=playground
WAA_BACKEND=spidermonkey
DISCOVER_HIDDEN_MODELS=false
