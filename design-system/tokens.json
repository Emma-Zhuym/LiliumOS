{
  "$name": "Emma Soft Clay UI",
  "$version": "1.0.0",
  "$description": "Emma Soft Clay UI v1.0「F」：全平（无投影、无凹陷阴影），分层靠细线与明度差；中性去黄底；圆角 12；16 色 OKLCH 公式；标题衬线；浮层用 iOS 18 雾面材质。",
  "foundation": {
    "appBackground": "#F8F9F7",
    "surface": "#FFFFFF",
    "surfaceWarm": "#F2F4F0",
    "surfaceSunken": "#EDEFEA",
    "surfaceRaised": "#FFFFFF",
    "textPrimary": "#23262A",
    "textSecondary": "#5D635F",
    "textTertiary": "#959B96",
    "borderSoft": "#E3E6E0",
    "borderStrong": "#CBCFC8",
    "divider": "#EBEEE8",
    "globalAccent": "#B4402F"
  },
  "status": {
    "success": {
      "tint": "#E7F3E9",
      "main": "#53A768",
      "ink": "#246135"
    },
    "warning": {
      "tint": "#F7EDE2",
      "main": "#ECA84A",
      "ink": "#7B510D"
    },
    "danger": {
      "tint": "#FCEBE9",
      "main": "#CA6862",
      "ink": "#7F3B37"
    },
    "info": {
      "tint": "#E7F0FC",
      "main": "#4982C9",
      "ink": "#2B5386"
    }
  },
  "palette": {
    "red": {
      "tint": "#FCEBE9",
      "soft": "#FFCBC5",
      "main": "#CA6862",
      "ink": "#7F3B37"
    },
    "rose": {
      "tint": "#FBEAEE",
      "soft": "#FCC9D6",
      "main": "#CC6C89",
      "ink": "#7C3A4E"
    },
    "orange": {
      "tint": "#FAECE4",
      "soft": "#FACFB5",
      "main": "#D87E42",
      "ink": "#844A23"
    },
    "amber": {
      "tint": "#F7EDE2",
      "soft": "#F2D3AE",
      "main": "#ECA84A",
      "ink": "#7B510D"
    },
    "yellow": {
      "tint": "#F3EFE1",
      "soft": "#E5D9AD",
      "main": "#E6C959",
      "ink": "#6C5904"
    },
    "lime": {
      "tint": "#ECF2E4",
      "soft": "#D0E1B6",
      "main": "#A4C661",
      "ink": "#4F6422"
    },
    "green": {
      "tint": "#E7F3E9",
      "soft": "#BEE5C5",
      "main": "#53A768",
      "ink": "#246135"
    },
    "mint": {
      "tint": "#E4F3ED",
      "soft": "#B3E6D2",
      "main": "#37B78F",
      "ink": "#006249"
    },
    "teal": {
      "tint": "#E2F4F1",
      "soft": "#ACE7E0",
      "main": "#0CABA2",
      "ink": "#05605A"
    },
    "cyan": {
      "tint": "#E2F3F7",
      "soft": "#ACE4F2",
      "main": "#06B1CE",
      "ink": "#025D6D"
    },
    "blue": {
      "tint": "#E7F0FC",
      "soft": "#C1DCFE",
      "main": "#4982C9",
      "ink": "#2B5386"
    },
    "indigo": {
      "tint": "#EBEFFC",
      "soft": "#CED7FE",
      "main": "#6170C0",
      "ink": "#434D87"
    },
    "purple": {
      "tint": "#F0EDFB",
      "soft": "#DDD1FC",
      "main": "#8A6EC1",
      "ink": "#594680"
    },
    "violet": {
      "tint": "#F5EBF7",
      "soft": "#EBCDF2",
      "main": "#AA6FB8",
      "ink": "#694073"
    },
    "brown": {
      "tint": "#F8EEE7",
      "soft": "#E3CCBB",
      "main": "#9F7655",
      "ink": "#614731"
    },
    "gray": {
      "tint": "#EEF1EF",
      "soft": "#D1D6D1",
      "main": "#818882",
      "ink": "#434A44"
    }
  },
  "radius": {
    "tiny": 4,
    "small": 8,
    "medium": 10,
    "large": 12,
    "panel": 14,
    "sheet": 16,
    "pill": 999,
    "usage": {
      "button": 10,
      "input": 10,
      "smallCard": 10,
      "bigCard": 12,
      "bottomSheet": 16,
      "iconButton": 999
    }
  },
  "shadow": {
    "raisedSoft": "none",
    "raisedMedium": "none",
    "floating": "none",
    "sunken": "none",
    "$note": "全平。名字保留给旧代码引用。层次 = 1px borderSoft + surface/appBg 明度差 + 浮层动效。"
  },
  "spacing": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    48,
    64
  ],
  "layout": {
    "pageMarginMobile": 20,
    "pageMarginDesktop": 24,
    "cardGap": 12,
    "sectionGap": 24
  },
  "typography": {
    "fontFamily": "'Noto Sans SC', system-ui, -apple-system, sans-serif",
    "scale": {
      "display": {
        "size": 30,
        "line": 38,
        "weight": 600
      },
      "title": {
        "size": 24,
        "line": 32,
        "weight": 600
      },
      "section": {
        "size": 18,
        "line": 26,
        "weight": 600
      },
      "body": {
        "size": 15,
        "line": 23,
        "weight": 400
      },
      "bodyStrong": {
        "size": 15,
        "line": 23,
        "weight": 600
      },
      "caption": {
        "size": 13,
        "line": 18,
        "weight": 400
      },
      "tiny": {
        "size": 12,
        "line": 16,
        "weight": 400
      }
    },
    "fontHeading": "'Noto Serif SC', 'Songti SC', serif",
    "headingUsage": "只给 App 顶栏标题（17/700）、sheet 标题（17/700）、section 小标题（15.5/600）。数字、正文、标签一律无衬线。"
  },
  "icon": {
    "stroke": 2,
    "cap": "round",
    "join": "round",
    "sizeSmall": 18,
    "sizeNormal": 22,
    "sizeLarge": 26,
    "button": 44,
    "buttonStyle": "裸 icon：无底、无描边、无投影；icon 21px textPrimary；触控区仍为 44×44"
  },
  "motion": {
    "durations": {
      "tap": 100,
      "hover": 140,
      "cardMove": 180,
      "sheet": 240,
      "page": 280,
      "sheetIn": 460,
      "toastIn": 560,
      "toastOut": 380
    },
    "curve": "cubic-bezier(.2,.8,.2,1)",
    "curveSheet": "cubic-bezier(.32,.72,0,1)",
    "curvePop": "cubic-bezier(.34,1.36,.64,1)",
    "press": {
      "iconButton": "opacity .4",
      "button": "scale(.95)",
      "card": "scale(.985)",
      "timing": "按下 70ms，松开 240ms"
    },
    "classes": "utils/clayMotion.css：clay-sheet-in / clay-toast-in / clay-pop / clay-rise / clay-draw(-dash) / clay-press(-card)"
  },
  "ringProgress": {
    "track": "flat groove：surfaceSunken 底色，无内阴影",
    "fill": "Hue Main, round cap, starts at 12 o'clock",
    "under100": "single arc, solid Main",
    "at100": "full ring, solid Main",
    "overfill": {
      "path": "SAME ring path, continue from 12 o'clock over the base ring",
      "noOffset": true,
      "noThicken": true,
      "noInnerOuterRings": true,
      "startColor": "exactly Hue Main — zero seam against the full ring",
      "gradient": "linear deepening along the arc from 100% onward, ending at Hue Ink",
      "end": "round cap in Ink — the dark cap marks how far past 100%",
      "svgNote": "gradient coords rotate with the element's transform; pre-rotate the gradient vector to compensate (e.g. rotate(-90) ⇒ vertical becomes x1=133,y1=70,x2=10,y2=70 in a 140 viewBox)"
    }
  },
  "overlay": {
    "bg": "rgba(250,251,249,.66)",
    "blur": "blur(26px) saturate(175%)",
    "edge": "1px solid rgba(255,255,255,.78)",
    "hairline": "0 -.5px 0 rgba(35,38,42,.14)",
    "grab": "rgba(35,38,42,.22)",
    "well": "rgba(118,124,140,.12)",
    "toastBg": "rgba(232,235,230,.80)",
    "toastEdge": "1px solid rgba(35,38,42,.14)",
    "scrim": "transparent",
    "scrimModal": "rgba(35,38,42,.22)"
  }
}
